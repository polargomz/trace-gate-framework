{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-gate.dev/schemas/trace-gate.schema.json",
  "title": "TRACE Gate Framework contracts",
  "$defs": {
    "identifier": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nullableIdentifier": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["pass", "warn", "fail", "blocked", "measuring"]},
    "requestReceipt": {
      "type": "object",
      "required": ["request_id", "received_at", "request_text", "scope", "boundaries", "completion", "pre_action_gate"],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "received_at": {"type": ["string", "object"]},
        "request_text": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "required": ["goals", "non_goals", "allowed_side_effects", "forbidden_actions"]},
        "boundaries": {"type": "object", "required": ["allowed_write_roots", "forbidden_write_roots", "writer_authority_change"]},
        "completion": {"type": "object", "required": ["required_artifacts", "required_tests", "required_gates"]},
        "pre_action_gate": {"type": "object", "required": ["classified_before_execution", "gate_status"]}
      },
      "additionalProperties": true
    },
    "ticket": {
      "type": "object",
      "required": ["ticket_id", "request_id", "title", "status", "acceptance_criteria", "verification"],
      "properties": {
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "acceptance_criteria": {"type": "array"},
        "verification": {"type": "array"}
      },
      "additionalProperties": true
    },
    "evidenceManifest": {
      "type": "object",
      "required": ["evidence_id", "request_id", "observed_at", "source", "runtime", "validation", "artifacts", "secrets_redacted"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "source": {"type": "object"},
        "runtime": {"type": "object"},
        "validation": {"type": "object", "required": ["tests_passed", "tests_failed", "invariant_passed"]},
        "artifacts": {"type": "array"},
        "secrets_redacted": {"const": true}
      },
      "additionalProperties": true
    },
    "gateDecision": {
      "type": "object",
      "required": ["schema_version", "gate_id", "evaluator", "required", "decision"],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "gate_id": {"$ref": "#/$defs/identifier"},
        "evaluator": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
        },
        "required": {"type": "object", "minProperties": 1},
        "decision": {
          "type": "object",
          "required": ["newly_allowed_authority", "still_forbidden"],
          "properties": {
            "newly_allowed_authority": {"$ref": "#/$defs/stringArray"},
            "still_forbidden": {"$ref": "#/$defs/stringArray"}
          }
        }
      },
      "additionalProperties": true
    },
    "documentAccessIntent": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "access_intent_id", "trace_id", "request_id", "actor", "purpose", "targets", "retrieval", "constraints"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "access_intent_id": {"$ref": "#/$defs/identifier"},
        "trace_id": {"$ref": "#/$defs/identifier"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "actor": {"type": "object", "required": ["actor_id", "roles", "interface_type"]},
        "purpose": {
          "type": "object",
          "required": ["purpose_class", "declared_purpose", "operation"],
          "properties": {
            "purpose_class": {"enum": ["lookup", "decision_support", "authoring", "controlled_change", "incident_response", "audit_reconstruction"]},
            "declared_purpose": {"type": "string", "minLength": 8},
            "operation": {"enum": ["read", "create", "revise", "publish", "archive", "restore", "dispose"]}
          }
        },
        "targets": {"type": "object"},
        "retrieval": {
          "type": "object",
          "required": ["mode", "embedding_group_ids"],
          "properties": {
            "mode": {"enum": ["exact", "semantic", "hybrid"]},
            "embedding_group_ids": {"$ref": "#/$defs/stringArray"},
            "query_digest": {
              "oneOf": [
                {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
                {"type": "null"}
              ]
            }
          }
        },
        "constraints": {
          "type": "object",
          "required": ["maximum_sensitivity", "freshness_requirement", "context_budget_bytes", "raw_access_requested"],
          "properties": {
            "maximum_sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
            "context_budget_bytes": {"type": "integer", "minimum": 1},
            "raw_access_requested": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": true
    },
    "documentManifest": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "manifest_id", "status", "identity", "governance", "integrity", "lineage", "storage", "freshness", "access", "tiers", "validation"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "manifest_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["draft", "active", "superseded", "archived", "rejected", "disposed"]},
        "identity": {"type": "object", "required": ["artifact_id", "revision_id"]},
        "governance": {"type": "object", "required": ["owner", "producer", "approvers", "validators"]},
        "integrity": {"type": "object", "required": ["algorithm", "subjects"]},
        "lineage": {"type": "object"},
        "storage": {"type": "object", "required": ["canonical_location", "retention_class"]},
        "freshness": {"type": "object", "required": ["mode", "status"]},
        "access": {"type": "object", "required": ["sensitivity", "contains_secrets"]},
        "tiers": {"type": "object", "required": ["summary", "overview", "records"]},
        "validation": {"type": "object", "required": ["status"]},
        "semantic_projection": {
          "type": "object",
          "required": ["eligible", "group_memberships", "embedding_manifest_refs"],
          "properties": {
            "eligible": {"type": "boolean"},
            "group_memberships": {"$ref": "#/$defs/stringArray"},
            "embedding_manifest_refs": {"$ref": "#/$defs/stringArray"}
          }
        }
      },
      "additionalProperties": true
    },
    "documentReadProfile": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "profile_id", "status", "applies_to", "selection", "semantic_retrieval", "limits", "validation", "fallback", "escalation"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["draft", "active", "superseded", "deprecated"]},
        "applies_to": {"type": "object"},
        "selection": {"type": "object", "required": ["default_tiers", "full_history_allowed", "raw_access_allowed"]},
        "limits": {"type": "object", "required": ["maximum_sensitivity", "max_context_bytes", "max_records"]},
        "validation": {"type": "object"},
        "fallback": {"type": "object"},
        "escalation": {"type": "object"},
        "semantic_retrieval": {
          "type": "object",
          "required": ["mode", "allowed_group_ids", "max_candidates", "minimum_score", "allow_cross_group"],
          "properties": {
            "mode": {"enum": ["disabled", "optional", "required"]},
            "allowed_group_ids": {"$ref": "#/$defs/stringArray"},
            "max_candidates": {"type": "integer", "minimum": 1},
            "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
            "allow_cross_group": {"type": "boolean"},
            "exact_fallback": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": true
    },
    "documentGateReceipt": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "receipt_id", "trace_id", "request_id", "access_intent_id", "review", "gate_results", "access_plan", "evidence_refs"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "receipt_id": {"$ref": "#/$defs/identifier"},
        "trace_id": {"$ref": "#/$defs/identifier"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "access_intent_id": {"$ref": "#/$defs/identifier"},
        "review": {"type": "object"},
        "gate_results": {"type": "array", "minItems": 1},
        "access_plan": {"type": "object", "required": ["decision", "allowed", "excluded", "context_budget_bytes"]},
        "evidence_refs": {"type": "array"}
      },
      "additionalProperties": true
    },
    "documentEmbeddingProfile": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "embedding_group_id", "status", "scope", "source_selection", "model", "index", "retrieval", "access", "freshness", "validation"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "embedding_group_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["draft", "active", "suspended", "deprecated"]},
        "scope": {
          "type": "object",
          "required": ["membership_mode", "include_artifact_ids", "include_artifact_types", "include_tags", "exclude_artifact_ids", "allow_partial_coverage"],
          "properties": {
            "membership_mode": {"enum": ["explicit", "selector"]},
            "include_artifact_ids": {"$ref": "#/$defs/stringArray"},
            "include_artifact_types": {"$ref": "#/$defs/stringArray"},
            "include_tags": {"$ref": "#/$defs/stringArray"},
            "exclude_artifact_ids": {"$ref": "#/$defs/stringArray"},
            "allow_partial_coverage": {"type": "boolean"}
          }
        },
        "source_selection": {
          "type": "object",
          "required": ["tiers", "chunking", "exclude_fields"],
          "properties": {
            "tiers": {"type": "array", "items": {"enum": ["summary", "overview", "selected_records", "full_records"]}, "minItems": 1, "uniqueItems": true},
            "chunking": {"type": "object", "required": ["strategy", "max_chunk_bytes", "overlap_bytes"]},
            "exclude_fields": {"$ref": "#/$defs/stringArray"}
          }
        },
        "model": {
          "type": "object",
          "required": ["model_id", "model_version", "dimensions", "normalization"],
          "properties": {
            "model_id": {"type": "string", "minLength": 1},
            "model_version": {"type": "string", "minLength": 1},
            "dimensions": {"type": "integer", "minimum": 1},
            "normalization": {"enum": ["none", "l2", "provider_defined"]}
          }
        },
        "index": {
          "type": "object",
          "required": ["kind", "distance_metric", "location", "graph"],
          "properties": {
            "kind": {"enum": ["flat", "graph", "provider_managed"]},
            "distance_metric": {"enum": ["cosine", "dot_product", "euclidean"]},
            "location": {"type": ["string", "null"]},
            "graph": {
              "type": ["object", "null"],
              "properties": {"algorithm": {"type": "string"}, "parameters": {"type": "object"}}
            }
          }
        },
        "retrieval": {
          "type": "object",
          "required": ["allowed_purpose_classes", "max_candidates", "minimum_score", "allow_cross_group"],
          "properties": {
            "allowed_purpose_classes": {"$ref": "#/$defs/stringArray"},
            "max_candidates": {"type": "integer", "minimum": 1},
            "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
            "allow_cross_group": {"type": "boolean"}
          }
        },
        "access": {
          "type": "object",
          "required": ["maximum_sensitivity", "inherit_source_sensitivity", "allow_secret_content"],
          "properties": {
            "maximum_sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
            "inherit_source_sensitivity": {"const": true},
            "allow_secret_content": {"const": false}
          }
        },
        "freshness": {"type": "object", "required": ["mode", "on_source_revision_change", "on_model_version_change"]},
        "validation": {"type": "object", "required": ["require_source_digest", "require_vector_digest", "require_membership_match"]}
      },
      "additionalProperties": true
    },
    "documentEmbeddingManifest": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "embedding_manifest_id", "embedding_group_id", "status", "generated_at", "model", "source_members", "index", "freshness", "validation"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "embedding_manifest_id": {"$ref": "#/$defs/identifier"},
        "embedding_group_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["draft", "active", "stale", "rejected", "archived"]},
        "generated_at": {"type": "string"},
        "model": {"type": "object", "required": ["model_id", "model_version", "dimensions", "normalization"]},
        "source_members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "revision_id", "source_digest", "chunks"],
            "properties": {
              "artifact_id": {"$ref": "#/$defs/identifier"},
              "revision_id": {"$ref": "#/$defs/identifier"},
              "source_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
              "chunks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["chunk_id", "content_digest", "vector_digest"],
                  "properties": {
                    "chunk_id": {"$ref": "#/$defs/identifier"},
                    "content_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
                    "vector_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
                  }
                }
              }
            }
          }
        },
        "index": {
          "type": "object",
          "required": ["kind", "location", "index_digest", "record_count"],
          "properties": {
            "kind": {"enum": ["flat", "graph", "provider_managed"]},
            "location": {"type": "string", "minLength": 1},
            "index_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
            "record_count": {"type": "integer", "minimum": 0},
            "graph": {"type": "object"}
          }
        },
        "freshness": {"type": "object", "required": ["status", "evaluated_at", "reason"]},
        "validation": {"type": "object", "required": ["status", "validated_at", "failures"]}
      },
      "additionalProperties": true
    },
    "managedDocumentManifest": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "manifest_id", "status", "identity", "scope", "governance", "time", "provenance", "integrity", "validation", "lineage", "storage", "freshness", "access", "discovery", "documents"],
      "properties": {
        "schema_version": {"const": "0.2.0"},
        "subframework_id": {"const": "TRACE-DM"},
        "manifest_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["draft", "active", "superseded", "archived"]},
        "identity": {"type": "object", "required": ["artifact_id", "artifact_type", "revision_id", "schema_version"]},
        "scope": {"type": "object", "required": ["system", "domain", "stage", "purpose", "classification"]},
        "governance": {"type": "object", "required": ["owner", "producer", "approvers", "validators", "custodian"]},
        "time": {"type": "object", "required": ["created_at", "observed_at", "updated_at", "effective_at"]},
        "provenance": {"type": "object", "required": ["source_refs", "repository", "branch", "commit", "tool_version"]},
        "integrity": {
          "type": "object",
          "required": ["algorithm", "subjects", "self_hash_embedded", "signature_status"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "subjects": {"const": "documents"},
            "self_hash_embedded": {"const": false},
            "signature_status": {"enum": ["not_configured", "unsigned", "verified", "failed"]}
          }
        },
        "validation": {"type": "object", "required": ["status", "validator_id", "validator_version", "validated_at", "warnings", "failures"]},
        "lineage": {"type": "object", "required": ["parent_artifact_ids", "supersedes", "relations", "sequence"]},
        "storage": {"type": "object", "required": ["canonical_location", "replicas", "retention_class", "legal_hold"]},
        "freshness": {"type": "object", "required": ["mode", "status", "evaluated_at", "reason"]},
        "access": {"type": "object", "required": ["sensitivity", "contains_secrets", "access_policy_ref"]},
        "discovery": {
          "type": "object",
          "required": ["include_patterns", "exclude_roots"],
          "properties": {
            "include_patterns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "exclude_roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["identity", "scope", "governance", "time", "provenance", "integrity", "validation", "lineage", "storage", "freshness", "access"],
            "properties": {
              "identity": {"type": "object", "required": ["artifact_id", "artifact_type", "revision_id", "schema_version"]},
              "scope": {"type": "object", "required": ["system", "domain", "stage", "purpose", "classification"]},
              "governance": {"type": "object", "required": ["owner", "producer", "approvers", "validators", "custodian"]},
              "time": {"type": "object", "required": ["created_at", "observed_at", "updated_at", "effective_at"]},
              "provenance": {"type": "object", "required": ["source_refs", "repository", "branch", "commit", "tool_version"]},
              "integrity": {
                "type": "object",
                "required": ["algorithm", "sha256", "size_bytes", "signature_status"],
                "properties": {
                  "algorithm": {"const": "sha256"},
                  "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                  "size_bytes": {"type": "integer", "minimum": 0},
                  "signature_status": {"enum": ["not_configured", "unsigned", "verified", "failed"]}
                }
              },
              "validation": {"type": "object", "required": ["status", "validator_id", "validator_version", "validated_at", "warnings", "failures"]},
              "lineage": {"type": "object", "required": ["parent_artifact_ids", "supersedes", "relations", "sequence"]},
              "storage": {"type": "object", "required": ["canonical_location", "replicas", "retention_class", "legal_hold"]},
              "freshness": {"type": "object", "required": ["mode", "status", "evaluated_at", "reason"]},
              "access": {"type": "object", "required": ["sensitivity", "contains_secrets", "access_policy_ref"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "agentRun": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "run_id", "trace_id", "request_id", "limits", "tool_policy", "verification"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "subframework_id": {"const": "TRACE-AH"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "trace_id": {"$ref": "#/$defs/identifier"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "limits": {"type": "object", "required": ["max_steps", "max_tool_calls", "deadline_seconds"]},
        "tool_policy": {"type": "object", "required": ["allowed_tools", "authorization_refs"]},
        "verification": {"type": "object", "required": ["required"]}
      },
      "additionalProperties": true
    },
    "toolDefinition": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "tool_id", "description", "effect", "risk", "input_schema", "timeout_seconds", "evidence"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "subframework_id": {"const": "TRACE-AH"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "effect": {"enum": ["read", "write", "destructive"]},
        "risk": {"enum": ["green", "amber", "red"]},
        "input_schema": {"type": "object"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "evidence": {"type": "object"}
      },
      "additionalProperties": true
    },
    "subagentTask": {
      "type": "object",
      "required": ["schema_version", "subframework_id", "task_id", "parent_run_id", "child_trace_id", "objective", "scope", "lease", "termination", "merge_policy"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "subframework_id": {"const": "TRACE-AH"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "parent_run_id": {"$ref": "#/$defs/identifier"},
        "child_trace_id": {"$ref": "#/$defs/identifier"},
        "objective": {"type": "string", "minLength": 8},
        "scope": {"type": "object", "required": ["read_roots", "write_roots", "allowed_tools"]},
        "lease": {"type": "object", "required": ["writer_key", "expires_at"]},
        "termination": {"type": "object", "required": ["deadline_seconds", "cancel_on_parent_cancel"]},
        "merge_policy": {"type": "object", "required": ["strategy", "conflict"]}
      },
      "additionalProperties": true
    }
  }
}
