          "const": "0.1.0"
        },
        "subframework_id": {
          "const": "TRACE-DM"
        },
        "original_transaction_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 3
        },
        "compensation_transaction_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 3
        },
        "compensates_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rollback_approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "destination_quiesced": {
          "type": "boolean"
        },
        "new_data_present": {
          "type": "boolean"
        },
        "new_data_preserved": {
          "type": "boolean"
        },
        "new_data_backup_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "previous_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "new_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "restore_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "restore_verified": {
          "type": "boolean"
        },
        "events_append_only": {
          "const": true
        },
        "t0_overwrite": {
          "const": false
        },
        "business_writes_enabled": {
          "const": false
        },
        "result": {
          "enum": [
            "pass",
            "blocked",
            "fail"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "subframework_id",
        "original_transaction_id",
        "compensation_transaction_id",
        "compensates_receipt_sha256",
        "rollback_approval_ref",
        "destination_quiesced",
        "new_data_present",
        "new_data_preserved",
        "new_data_backup_sha256",
        "previous_epoch",
        "new_epoch",
        "restore_receipt_sha256",
        "restore_verified",
        "events_append_only",
        "t0_overwrite",
        "business_writes_enabled",
        "result",
        "blockers"
      ],
      "additionalProperties": false
    },
    "migrationLinkPolicy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "subframework_id": {
          "const": "TRACE-DM"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "descriptor_plan_only"
        },
        "restore_supported": {
          "const": false
        },
        "verified_inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "kind",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "revision_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "link_text_sha256": {
                "type": "string",
